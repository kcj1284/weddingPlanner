{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cheongmo",
  "main": "src/index.ts",
  "account_id": "b9d6ed169448a09f88974eddb539d8ca",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "mixdesk.org", "custom_domain": true }],
  "containers": [
    {
      "class_name": "CheongmoContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CHEONGMO", "class_name": "CheongmoContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CheongmoContainer"] }],
  "vars": {
    "PUBLIC_BASE_URL": "https://mixdesk.org"
  }
}
